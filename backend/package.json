{
    "name": "videomind-ai-backend",
    "version": "1.1.0",
    "description": "Backend for VideoMind AI - YouTube video transcription, summarisation and chat",
    "main": "src/app.js",
    "scripts": {
        "start": "node src/app.js",
        "dev": "node --watch src/app.js",
