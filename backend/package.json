        "dotenv": "^16.6.1",
        "express": "^4.22.3",
        "express-rate-limit": "^7.5.0",
        "youtube-transcript": "^1.3.1",
        "youtubei.js": "^18.3.0"
    },
    "overrides": {
        "qs": "^6.17.1"
