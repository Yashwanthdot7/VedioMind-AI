# VideoMind AI Backend Environment Variables
# Copy this file to .env and fill in your real values. Never commit .env to Git.

# Server
PORT=3001
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Google Gemini
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override the model if Google retires the default
GEMINI_MODEL=gemini-2.5-flash

# Supabase (optional — the app still works without it, but nothing is saved)
# Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
# SERVICE ROLE key: server only, never put this in the frontend
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
