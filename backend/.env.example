# VideoMind AI Backend Environment Variables
# Copy this file to .env and fill in your real values. Never commit .env to Git.

# Server
PORT=3001
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Google Gemini
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: model to try first. Leave empty to auto-pick the newest Flash model
# (falls back automatically if Google retires one).
GEMINI_MODEL=

# Supabase (optional — the app still works without it, but nothing is saved)
# Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
# SECRET key (sb_secret_...): server only, never put this in the frontend or commit it.
# Projects using legacy keys can set SUPABASE_SERVICE_ROLE_KEY instead.
SUPABASE_SECRET_KEY=your_secret_key_here
