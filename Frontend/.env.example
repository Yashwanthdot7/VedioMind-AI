# VideoMind AI Frontend Environment Variables
# Copy this file to .env and update with your values

# Backend API URL (required)
VITE_API_URL=http://localhost:3001/api

# Supabase (optional — leave blank to run without sign-in / saved library)
# Dashboard -> Project Settings -> API Keys. The PUBLISHABLE key (sb_publishable_...) is public and safe here.
# (Legacy projects can use VITE_SUPABASE_ANON_KEY instead.)
# NEVER put the secret key in the frontend.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Show "Continue with Google" only after enabling Google in Supabase -> Authentication -> Providers
VITE_ENABLE_GOOGLE_AUTH=false

# App information
VITE_APP_NAME=VideoMind AI
VITE_APP_VERSION=1.1.0
